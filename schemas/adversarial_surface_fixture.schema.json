{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adversarial_surface_fixture.schema.json",
  "title": "AdversarialSurfaceFixture",
  "description": "Schema for a single adversarial surface gate test fixture.",
  "type": "object",
  "required": [
    "fixture_id",
    "description",
    "probe",
    "expected"
  ],
  "additionalProperties": false,
  "properties": {
    "fixture_id": {
      "type": "string",
      "description": "Unique stable identifier for this fixture."
    },
    "description": {
      "type": "string",
      "description": "Human-readable intent for this fixture."
    },
    "probe": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "authority_present": { "type": "boolean", "default": false },
        "declared_frame": { "type": "string", "default": "default" },
        "requested_frame": { "type": "string", "default": "default" },
        "allow_interpretation": { "type": "boolean", "default": false },
        "allow_rotation": { "type": "boolean", "default": false }
      }
    },
    "expected": {
      "type": "object",
      "required": ["verdict", "pressure_class", "stop_state", "execution_allowed"],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["ALLOW", "HOLD", "DENY"]
        },
        "pressure_class": {
          "type": "string",
          "enum": [
            "NONE",
            "NEGATION_OVERRIDE",
            "INTERPRETATION_DRIFT",
            "PARADOX_INJECTION",
            "ROTATION_GEOMETRY",
            "MIXED_PRESSURE"
          ]
        },
        "stop_state": {
          "type": "string",
          "enum": ["GREEN", "AMBER", "RED"]
        },
        "execution_allowed": { "type": "boolean" }
      }
    }
  }
}
